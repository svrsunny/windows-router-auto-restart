<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing is copied to cloud backup or to a new phone (settings and the encrypted
     password stay on this device; the password's Keystore key couldn't be moved anyway). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
